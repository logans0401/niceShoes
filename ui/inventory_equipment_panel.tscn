[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/inventory_equipment_panel.gd" id="1_panel"]

[node name="InventoryEquipmentPanel" type="MarginContainer"]
clip_contents = true
layout_mode = 2
theme_override_constants/margin_left = 4
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 4
theme_override_constants/margin_bottom = 4
script = ExtResource("1_panel")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3

[node name="Header" type="Label" parent="VBox"]
layout_mode = 2
text = "Equipment & bag (24 slots)"

[node name="BurdenLabel" type="Label" parent="VBox"]
